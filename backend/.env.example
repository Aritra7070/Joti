# Gemini (free tier is fine — Flash models only)
GEMINI_API_KEY=
# Comma-separated fallback chain; first that answers wins
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_TEXT_MODELS=gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.7-flash

# MongoDB URI for job and user persistence (e.g. mongodb+srv://... or mongodb://localhost:27017).
# If left empty, the server defaults to local JSON file persistence in data_local/.
MONGODB_URI=
MONGODB_DB_NAME=cuepoint

# Auth token signing secret (any long random string). Falls back to a value derived from MONGODB_URI.
JWT_SECRET=
